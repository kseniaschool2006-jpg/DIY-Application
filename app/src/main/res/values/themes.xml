<resources xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <!-- Base application theme. -->
    <style name="Base.Theme.DIYProject" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/color_white</item>
    </style>

    <style name="Theme.DIYProject" parent="Base.Theme.DIYProject" />


<!--    может пригодится, может нет, это для элементов внутри других кликабельных элементов типо плюсик, редактировать-->
    <style name="CircleIconStyle">
        <item name="android:layout_width">30dp</item>
        <item name="android:layout_height">30dp</item>
        <item name="android:background">@drawable/bg_circle_green</item>
        <item name="android:scaleType">centerInside</item>
        <item name="android:padding">@dimen/space_s</item>
    </style>

    <style name="CircleImageStyle" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <style name="ChipStyle.Hashtag" parent="Widget.MaterialComponents.Chip.Action">

        <item name="android:textColor">@color/color_white</item>
        <item name="android:textAppearance">@style/TextAppearance.App.Subtext.Title</item>
        <item name="chipStartPadding">@dimen/space_s</item>
        <item name="chipEndPadding">@dimen/space_s</item>

        <item name="chipBackgroundColor">@color/color_green</item>
        <item name="chipCornerRadius">@dimen/space_xs</item>
        <item name="chipStrokeWidth">0dp</item>
        <item name="chipMinHeight">28dp</item>
        <item name="textStartPadding">0dp</item>
        <item name="textEndPadding">0dp</item>
        <item name="android:clickable">false</item>
        <item name="android:focusable">false</item>
        <item name="rippleColor">@android:color/transparent</item>
    </style>





</resources>