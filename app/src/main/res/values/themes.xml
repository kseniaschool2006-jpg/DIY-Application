<resources xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <!-- Base application theme. -->
    <style name="Base.Theme.DIYProject" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/color_white</item>
        <item name="colorPrimary">@color/color_beige_dark</item>
        <item name="colorOnPrimary">@color/color_white</item>
    </style>

    <style name="Theme.DIYProject" parent="Base.Theme.DIYProject" />


<!--    может пригодится, может нет, это для элементов внутри других кликабельных элементов типо плюсик, редактировать-->
    <style name="CircleIconStyle">
        <item name="android:layout_width">30dp</item>
        <item name="android:layout_height">30dp</item>
        <item name="android:background">@drawable/bg_circle_green</item>
        <item name="android:scaleType">centerInside</item>
        <item name="android:padding">@dimen/space_s</item>
    </style>

    <!-- Скругление картинки в карточке инструкции -->
    <style name="ShapeAppearance.App.Instruction" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/radius_standard</item>
    </style>

    <!-- Стиль картинки в карточке -->
    <style name="InstructionImageStyle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:adjustViewBounds">true</item>
        <item name="android:scaleType">centerCrop</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.App.Instruction</item>
    </style>
</resources>