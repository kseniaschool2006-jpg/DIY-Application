<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/toCheckFragment">

    <fragment
        android:id="@+id/storageFragmentMain"
        android:name="com.example.diyproject.ui.storage.StorageFragmentMain"
        android:label="StorageFragmentMain" >
        <action
            android:id="@+id/action_storageFragmentMain_to_newMaterialFragment1"
            app:destination="@id/newMaterialFragment1" />
        <action
            android:id="@+id/action_storageFragmentMain_to_editMaterialFragment"
            app:destination="@id/editMaterialFragment" />
    </fragment>
    <fragment
        android:id="@+id/newMaterialFragment1"
        android:name="com.example.diyproject.ui.storage.NewMaterialFragment1"
        android:label="fragment_new_material1"
        tools:layout="@layout/fragment_new_material1" >
        <action
            android:id="@+id/action_newMaterialFragment1_to_newMaterialFragment2"
            app:destination="@id/newMaterialFragment2" />
        <action
            android:id="@+id/action_newMaterialFragment1_to_editMaterialFragment"
            app:destination="@id/editMaterialFragment" />
        <action
            android:id="@+id/action_newMaterialFragment1_to_materialSelectionFragment"
            app:destination="@id/materialSelectionFragment" />
        <action
            android:id="@+id/action_newMaterialFragment1_to_storageFragmentMain"
            app:destination="@id/storageFragmentMain" />
    </fragment>
    <fragment
        android:id="@+id/newMaterialFragment2"
        android:name="com.example.diyproject.ui.storage.NewMaterialFragment2"
        android:label="fragment_new_material2"
        tools:layout="@layout/fragment_new_material2" >
        <action
            android:id="@+id/action_newMaterialFragment2_to_editMaterialFragment"
            app:destination="@id/editMaterialFragment" />
    </fragment>
    <fragment
        android:id="@+id/categorySelectionFragment"
        android:name="com.example.diyproject.ui.instruction.CategorySelectionFragment"
        android:label="fragment_category_selection"
        tools:layout="@layout/fragment_category_selection" >
        <argument
            android:name="selectedThemes"
            app:argType="string[]"
            app:nullable="true"
            android:defaultValue="@null" />
    </fragment>
    <fragment
        android:id="@+id/editMaterialFragment"
        android:name="com.example.diyproject.ui.storage.EditMaterialFragment"
        android:label="fragment_edit_material"
        tools:layout="@layout/fragment_edit_material" >
        <argument
            android:name="materialTitle"
            app:argType="string"
            app:nullable="true"
            android:defaultValue="@null" />
        <argument
            android:name="materialDescription"
            app:argType="string"
            app:nullable="true"
            android:defaultValue="@null" />
        <argument
            android:name="materialTag"
            app:argType="string"
            app:nullable="true"
            android:defaultValue="@null" />
        <argument
            android:name="materialIconRes"
            app:argType="integer"
            android:defaultValue="0" />
        <argument
            android:name="materialImageUriString"
            app:argType="string"
            app:nullable="true"
            android:defaultValue="@null" />
        <argument
            android:name="materialPosition"
            app:argType="integer"
            android:defaultValue="-1" />
        <action
            android:id="@+id/action_editMaterialFragment_to_categorySelectionFragment"
            app:destination="@id/categorySelectionFragment" />
        <action
            android:id="@+id/action_editMaterialFragment_to_storageFragmentMain"
            app:destination="@id/storageFragmentMain" />
    </fragment>
    <fragment
        android:id="@+id/editInstructionFragment"
        android:name="com.example.diyproject.ui.instruction.EditInstructionFragment"
        android:label="fragment_edit_instruction"
        tools:layout="@layout/fragment_edit_instruction" >
        <argument
            android:name="instructionImageUri"
            app:argType="string"
            android:defaultValue="empty"/>
        <action
            android:id="@+id/action_editInstructionFragment_to_categorySelectionFragment"
            app:destination="@id/categorySelectionFragment" />
    </fragment>
    <fragment
        android:id="@+id/toCheckFragment"
        android:name="com.example.diyproject.ui.common.ToCheckFragment"
        android:label="fragment_to_check"
        tools:layout="@layout/fragment_to_check" >
        <action
            android:id="@+id/action_toCheckFragment_to_storageFragmentMain"
            app:destination="@id/storageFragmentMain" />
        <action
            android:id="@+id/action_toCheckFragment_to_editInstructionFragment"
            app:destination="@id/editInstructionFragment" />
        <action
            android:id="@+id/action_toCheckFragment_to_profileFragment"
            app:destination="@id/profileFragment" />
    </fragment>
    <fragment
        android:id="@+id/materialSelectionFragment"
        android:name="com.example.diyproject.ui.storage.MaterialSelectionFragment"
        android:label="fragment_material_selection"
        tools:layout="@layout/fragment_material_selection" >
        <argument
            android:name="selectedMaterials"
            app:argType="string[]"
            app:nullable="true"
            android:defaultValue="@null" />
        <argument
            android:name="screenTitle"
            app:argType="string"
            app:nullable="true"
            android:defaultValue="Выбор материалов" />
        <argument
            android:name="showSettings"
            app:argType="boolean"
            android:defaultValue="false" />
        <argument
            android:name="showCheckBox"
            app:argType="boolean"
            android:defaultValue="true" />
        <action
            android:id="@+id/action_materialSelectionFragment_to_editMaterialFragment"
            app:destination="@id/editMaterialFragment" />
        <action
            android:id="@+id/action_materialSelectionFragment_to_storageFragmentMain"
            app:destination="@id/storageFragmentMain" />
    </fragment>

    <fragment
        android:id="@+id/profileFragment"
        android:name="com.example.diyproject.profile.ProfileFragment"
        android:label="fragment_profile"
        tools:layout="@layout/fragment_profile" >
        <action
            android:id="@+id/action_profileFragment_to_albumDetailFragment"
            app:destination="@id/albumDetailFragment" />
        <action
            android:id="@+id/action_profileFragment_to_editProfileFragment"
            app:destination="@id/editProfileFragment" />
    </fragment>
    <fragment
        android:id="@+id/albumDetailFragment"
        android:name="com.example.diyproject.profile.AlbumDetailFragment"
        android:label="fragment_album_detail"
        tools:layout="@layout/fragment_album_detail" >
        <argument
            android:name="album_id"
            app:argType="integer"
            android:defaultValue="-1" />

        <argument
            android:name="album_title"
            app:argType="string"
            android:defaultValue="Альбом" />

        <argument
            android:name="album_count"
            app:argType="integer"
            android:defaultValue="0" />
        <action
            android:id="@+id/action_albumDetailFragment_to_instructionDetailFragment"
            app:destination="@id/instructionDetailFragment" />
    </fragment>
    <fragment
        android:id="@+id/editProfileFragment"
        android:name="com.example.diyproject.profile.EditProfileFragment"
        android:label="fragment_edit_profile"
        tools:layout="@layout/fragment_edit_profile" />
    <fragment
        android:id="@+id/userAccountFragment"
        android:name="com.example.diyproject.profile.UserAccountFragment"
        android:label="fragment_user_account"
        tools:layout="@layout/fragment_user_account" >
        <argument
            android:name="user_id"
            android:defaultValue="-1L"
            app:argType="long" />
    </fragment>
    <fragment
        android:id="@+id/instructionDetailFragment"
        android:name="com.example.diyproject.instructionDetail.InstructionDetailFragment"
        android:label="fragment_instruction_detail"
        tools:layout="@layout/fragment_instruction_detail" >
        <argument
            android:name="instruction_id"
            android:defaultValue="-1L"
            app:argType="long" />
        <action
            android:id="@+id/action_instructionDetailFragment_to_userAccountFragment"
            app:destination="@id/userAccountFragment" />
    </fragment>
    <fragment
        android:id="@+id/loginFragment"
        android:name="com.example.diyproject.ui.authorization.LoginFragment"
        android:label="LoginFragment">
        <action
            android:id="@+id/action_login_to_code"
            app:destination="@id/codeFragment" />
    </fragment>

    <fragment
        android:id="@+id/codeFragment"
        android:name="com.example.diyproject.ui.authorization.CodeFragment"
        android:label="CodeFragment" />

    <fragment
        android:id="@+id/homeFragment"
        android:name="com.example.diyproject.ui.home.HomeFragment"
        android:label="HomeFragment" />

    <fragment
        android:id="@+id/searchStartFragment"
        android:name="com.example.diyproject.ui.search.SearchStartFragment"
        android:label="SearchStartFragment"
        tools:layout="@layout/fragment_search_start">
        <action
            android:id="@+id/action_searchStart_to_searchHistory"
            app:destination="@id/searchHistoryFragment" />
        <action
            android:id="@+id/action_searchStart_to_searchResult"
            app:destination="@id/searchResultFragment" />
    </fragment>

    <fragment
        android:id="@+id/searchHistoryFragment"
        android:name="com.example.diyproject.ui.search.SearchHistoryFragment"
        android:label="SearchHistoryFragment"
        tools:layout="@layout/fragment_search_history">
        <argument
            android:name="query"
            app:argType="string"
            android:defaultValue="" />
        <action
            android:id="@+id/action_searchHistory_to_searchResult"
            app:destination="@id/searchResultFragment"
            app:popUpTo="@id/searchHistoryFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/searchResultFragment"
        android:name="com.example.diyproject.ui.search.SearchResultFragment"
        android:label="SearchResultFragment"
        tools:layout="@layout/fragment_search_result">
        <argument
            android:name="query"
            app:argType="string"
            android:defaultValue="" />
        <action
            android:id="@+id/action_searchResult_to_searchHistory"
            app:destination="@id/searchHistoryFragment"
            app:popUpTo="@id/searchResultFragment"
            app:popUpToInclusive="true" />
    </fragment>
</navigation>