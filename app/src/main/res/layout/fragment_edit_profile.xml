<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/color_white"
    tools:context=".EditProfileFragment">

    <include
        android:id="@+id/topbar_close"
        layout="@layout/item_topbar_close"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>


    <ScrollView
        android:id="@+id/scrollView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/topbar_close">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="@dimen/space_margin">

            <TextView
                android:id="@+id/tvPrivacyNote"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/description_in_edit_profile"
                android:textAppearance="@style/TextAppearance.App.Subtext"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <LinearLayout
                android:id="@+id/box_avatar"
                android:layout_width="168dp"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvPrivacyNote"
                >

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardAvatar"
                    android:layout_width="145dp"
                    android:layout_height="145dp"
                    android:layout_marginTop="@dimen/space_large"
                    app:cardBackgroundColor="@color/color_menu_bg_secondary"
                    app:shapeAppearanceOverlay="@style/CircleImageStyle"
                    app:cardElevation="0dp"
                    app:strokeWidth="0dp">

                    <ImageView
                        android:id="@+id/ivAvatar"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:padding="30dp"
                        android:src="@drawable/ic_profile"/>
                </com.google.android.material.card.MaterialCardView>

                <Button
                    android:id="@+id/btnEditAvatar"
                    style="@style/ButtonStyle.Secondary"
                    android:layout_marginTop="@dimen/space_xs"
                    android:text="@string/edit_btn"
                    />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/boxName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/box_avatar"
                android:orientation="vertical"
                android:layout_marginTop="@dimen/space_large">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="@color/color_white"
                    app:cardCornerRadius="@dimen/radius_standard"
                    app:cardElevation="0dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="@color/color_beige_dark"
                    app:cardPreventCornerOverlap="true">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingStart="@dimen/space_medium"
                        android:paddingBottom="@dimen/space_s"
                        android:paddingEnd="@dimen/space_medium"
                        android:paddingTop="@dimen/space_s">

                        <TextView
                            style="@style/TextAppearance.App.Subtext.Title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Имя"
                            android:textColor="@color/color_beige_dark" />

                        <EditText
                            android:id="@+id/etName"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_xs"
                            android:background="@null"
                            android:hint="Имя"
                            android:textAppearance="@style/TextAppearance.App.Body"
                            android:textColor="@color/color_beige_dark"
                            android:textColorHint="@color/color_beige_dark_30"
                            android:inputType="text"
                            android:maxLength="100" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

            <LinearLayout
                android:id="@+id/boxUsername"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/boxName"
                android:orientation="vertical"
                android:layout_marginTop="@dimen/space_margin">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="@color/color_white"
                    app:cardCornerRadius="@dimen/radius_standard"
                    app:cardElevation="0dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="@color/color_beige_dark"
                    app:cardPreventCornerOverlap="true">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingStart="@dimen/space_medium"
                        android:paddingBottom="@dimen/space_s"
                        android:paddingEnd="@dimen/space_medium"
                        android:paddingTop="@dimen/space_s">

                        <TextView
                            style="@style/TextAppearance.App.Subtext.Title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Имя пользователя"
                            android:textColor="@color/color_beige_dark" />

                        <EditText
                            android:id="@+id/etUsername"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_xs"
                            android:background="@null"
                            android:hint="Имя пользователя"
                            android:textAppearance="@style/TextAppearance.App.Body"
                            android:textColor="@color/color_beige_dark"
                            android:textColorHint="@color/color_beige_dark_30"
                            android:inputType="text"
                            android:maxLength="100" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

            <LinearLayout
                android:id="@+id/boxAbout"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/boxUsername"
                android:orientation="vertical"
                android:layout_marginTop="@dimen/space_margin">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="@color/color_white"
                    app:cardCornerRadius="@dimen/radius_standard"
                    app:cardElevation="0dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="@color/color_beige_dark"
                    app:cardPreventCornerOverlap="true">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingStart="@dimen/space_medium"
                        android:paddingBottom="@dimen/space_s"
                        android:paddingEnd="@dimen/space_medium"
                        android:paddingTop="@dimen/space_s"
                        android:minHeight="147dp">

                        <TextView
                            style="@style/TextAppearance.App.Subtext.Title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Сведения"
                            android:textColor="@color/color_beige_dark" />

                        <EditText
                            android:id="@+id/etAbout"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_xs"
                            android:background="@null"
                            android:hint="Расскажи свою историю..."
                            android:textAppearance="@style/TextAppearance.App.Body"
                            android:textColor="@color/color_beige_dark"
                            android:textColorHint="@color/color_beige_dark_30"
                            android:inputType="textMultiLine|textCapSentences"
                             />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

            <LinearLayout
                android:id="@+id/boxWebsite"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/boxAbout"
                android:orientation="vertical"
                android:layout_marginTop="@dimen/space_margin">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="@color/color_white"
                    app:cardCornerRadius="@dimen/radius_standard"
                    app:cardElevation="0dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="@color/color_beige_dark"
                    app:cardPreventCornerOverlap="true">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingStart="@dimen/space_medium"
                        android:paddingBottom="@dimen/space_s"
                        android:paddingEnd="@dimen/space_medium"
                        android:paddingTop="@dimen/space_s">

                        <TextView
                            style="@style/TextAppearance.App.Subtext.Title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Веб-сайт"
                            android:textColor="@color/color_beige_dark" />

                        <EditText
                            android:id="@+id/etWebsite"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_xs"
                            android:background="@null"
                            android:hint="Добавьте ссылку для привлечения трафика на свой сайт"
                            android:textAppearance="@style/TextAppearance.App.Body"
                            android:textColor="@color/color_beige_dark"
                            android:textColorHint="@color/color_beige_dark_30"
                            android:inputType="textUri"
                             />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>



    </ScrollView>





</androidx.constraintlayout.widget.ConstraintLayout>