<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".BlankFragment"
    android:orientation="vertical"
    android:padding="@dimen/space_margin">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:clipChildren="false">
            <Button
                style="@style/ButtonStyle.Primary"
                android:text="Сохранить" />


            <Button
                style="@style/ButtonStyle.Secondary"
                android:text="Отмена" />

            <ImageButton
                style="@style/IconButtonStyle"
                android:src="@drawable/ic_arrow_back" />

            <ImageButton
                style="@style/IconButtonStyle"
                android:src="@drawable/ic_arrow_forward" />

            <ImageButton
                style="@style/IconButtonStyle"
                android:src="@drawable/ic_close" />

            <ImageButton
                style="@style/IconButtonStyle.Green"
                android:src="@drawable/ic_question" />

            <ImageButton
                style="@style/IconButtonStyle"
                android:src="@drawable/ic_settings" />

            <ImageButton
                style="@style/IconButtonStyle.Green"
                android:src="@drawable/ic_share" />

            <ImageButton
                style="@style/IconButtonStyle"
                android:src="@drawable/ic_more_horiz" />

            <!--    добавила в string строчку, чтобы хештег был всегда, в коде толкьо текст менять-->
            <!--    String tagName = "ремонт";-->
            <!--    tagMaterial.setText(getString(R.string.tag_hash_format, tagName));-->
            <TextView
                style="@style/TagStyle.Green"
                android:text="# хештег" />

            <TextView
                style="@style/TagStyle.Orange"
                android:text="# хештег" />

            <include
                layout="@layout/item_category_choose_card" />

            <include
                layout="@layout/item_material_card" />





            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|end"
                android:layout_margin="@dimen/space_margin"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:paddingEnd="4dp"
                android:paddingBottom="4dp">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/fabMain"
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:clickable="true"
                    android:focusable="true"
                    app:cardBackgroundColor="@color/color_white"
                    app:cardCornerRadius="30dp"
                    app:cardElevation="4dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="@color/color_beige_dark_30"
                    app:rippleColor="@color/color_beige_dark_30">

                <ImageView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_material"
                    app:tint="@color/color_green" />
            </com.google.android.material.card.MaterialCardView>

            <FrameLayout
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="bottom|end"
                android:background="@drawable/bg_circle_green">

                <ImageView
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_add"
                    app:tint="@color/color_white" />
            </FrameLayout>

        </FrameLayout>




            <!--    это кнопка вперед при оформлении поста-->
            <FrameLayout
                android:id="@+id/btnEdit"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:clickable="true"
                android:focusable="true"
                android:background="@drawable/bg_icon_ripple">

                <FrameLayout
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_circle_green">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_arrow"
                        app:tint="@color/color_white"
                        />
                </FrameLayout>
            </FrameLayout>


            <com.google.android.material.chip.Chip
                style="@style/ChipStyle.Category"
                android:text="Вязание"
                app:chipIcon="@drawable/ic_star" />

            <include layout="@layout/view_input" />

            <include layout="@layout/view_input_with_tag" />


        </LinearLayout>
    </ScrollView>


</LinearLayout>