<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:layout_marginBottom="@dimen/space_medium">

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardTime"
        style="@style/CardStyle.Selector"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clickable="true"
        android:focusable="true"
        app:rippleColor="@color/color_beige_dark_30"
        android:layout_marginBottom="@dimen/space_xs">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:paddingHorizontal="@dimen/space_margin">

            <TextView
                android:id="@+id/tvSelectedTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1 час"
                android:textAppearance="@style/TextAppearance.App.Body"
                android:textColor="@color/color_beige_dark" />

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginStart="@dimen/space_s"
                android:src="@drawable/ic_chevron_down"
                app:tint="@color/color_beige_dark" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:text="Сколько времени требует проект"
        android:textAppearance="@style/TextAppearance.App.Subtext"
        android:textColor="@color/color_beige_dark_30" />

</LinearLayout>