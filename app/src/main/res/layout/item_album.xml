<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:tools="http://schemas.android.com/tools"
    android:orientation="vertical"

    >

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="116dp"
        app:cardElevation="0dp"
        app:cardCornerRadius="@dimen/radius_standard">
        
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal">
            <ImageView
                android:id="@+id/ivCover1"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="2dp"
                android:layout_weight="1.4"
                android:scaleType="centerCrop"
                android:src="@drawable/album_image1"/>

            <!-- Правая колонка из двух фото (40% ширины) -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/ivCover2"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_marginBottom="2dp"
                    android:layout_weight="1"
                    android:scaleType="centerCrop"
                    android:src="@drawable/album_image1"/>

                <ImageView
                    android:id="@+id/ivCover3"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:scaleType="centerCrop"
                    android:src="@drawable/album_image1"/>
            </LinearLayout>

        </LinearLayout>

   </androidx.cardview.widget.CardView >
    <TextView
        android:id="@+id/tvAlbumTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        tools:text="Брелоки"
        android:textAppearance="@style/TextAppearance.App.Subtext.Title" />

    <TextView
        android:id="@+id/tvAlbumCount"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        tools:text="12 инструкций"
        android:textAppearance="@style/TextAppearance.App.Subtext"
         />

</LinearLayout>
