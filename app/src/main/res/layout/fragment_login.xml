<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="@dimen/space_margin">

    <TextView
        style="@style/TextAppearance.App.Title.OnAuthorization"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="76dp"
        android:text="Авторизация" />

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/til_login"
        style="@style/Widget.App.Input"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/space_large"
        android:hint="Почта или номер телефона">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/et_login"
            style="@style/Widget.App.Input.EditText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textEmailAddress" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_login"
        style="@style/ButtonStyle.Primary"
        android:layout_marginBottom="126dp"
        android:text="Войти" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_google"
        style="@style/Widget.Material3.Button.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/space_large"
        android:paddingBottom="@dimen/space_s"
        android:paddingTop="@dimen/space_s"
        android:text="Вход с аккаунтом Google"
        android:textAllCaps="false"
        app:cornerRadius="@dimen/radius_pill"
        app:icon="@drawable/ic_google"
        app:iconPadding="8dp"
        app:iconTint="@null"
        app:strokeColor="@color/color_beige_dark"
        app:strokeWidth="1dp" />

    <TextView
        style="@style/TextAppearance.App.Title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/space_margin"
        android:text="Войти через соц-сеть" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/btn_instagram"
            style="@style/IconButtonStyle.NoColor"
            android:src="@drawable/ic_instagram"
             />

        <ImageButton
            android:id="@+id/btn_tiktok"
            style="@style/IconButtonStyle.NoColor"
            android:src="@drawable/ic_tiktok"
            android:layout_marginStart="@dimen/radius_large"
            android:layout_marginEnd="@dimen/radius_large"
            />


        <ImageButton
            android:id="@+id/btn_pinterest"
            style="@style/IconButtonStyle.NoColor"
            android:src="@drawable/ic_pinterest"
            />
    </LinearLayout>

</LinearLayout>