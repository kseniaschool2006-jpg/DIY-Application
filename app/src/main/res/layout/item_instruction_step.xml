<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/CardStyle.Selector"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/space_s">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/space_margin"
        android:paddingEnd="@dimen/space_s">

        <FrameLayout
            android:id="@+id/frameStepAction"
            android:layout_width="48dp"
            android:layout_height="48dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardStepPreview"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone"
                app:cardCornerRadius="@dimen/radius_small"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <ImageView
                    android:id="@+id/ivStepPreview"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop" />

            </com.google.android.material.card.MaterialCardView>

            <ImageButton
                android:id="@+id/ivStepIcon"
                style="@style/IconButtonStyle.Green"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/ic_gallery" />

        </FrameLayout>

        <EditText
            android:id="@+id/etStepTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:hint="Введите подзаголовок"
            android:background="@null"
            android:inputType="textMultiLine"
            android:saveEnabled="false"
            android:textAppearance="@style/TextAppearance.App.Title"
            android:textColor="@color/color_beige_dark"
            app:layout_constraintEnd_toStartOf="@id/frameStepAction"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            android:maxLength="100" />

        <EditText
            android:id="@+id/etStepSubtitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:background="@null"
            android:hint="Шаг 1"
            android:inputType="textMultiLine"
            android:saveEnabled="false"
            android:textAppearance="@style/TextAppearance.App.Body"
            android:textColor="@color/color_beige_dark"
            android:textColorHint="@color/color_beige_dark_30"
            app:layout_constraintEnd_toStartOf="@id/frameStepAction"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/etStepTitle"
            android:maxLength="2000" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>
