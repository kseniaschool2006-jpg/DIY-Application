<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/CardStyle.Selector"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/space_s">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/space_margin"
        android:paddingEnd="@dimen/space_s">

        <EditText
            android:id="@+id/tvStepTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:hint="Введите название для пункта инструкции"
            android:inputType="text"
            android:textAppearance="@style/TextAppearance.App.Title"
            android:textColor="@color/color_beige_dark"
            app:layout_constraintEnd_toStartOf="@id/ivStepIcon"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <EditText
            android:id="@+id/etStepSubtitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:background="@null"
            android:hint="Шаг 1"
            android:inputType="text"
            android:textAppearance="@style/TextAppearance.App.Body"
            android:textColor="@color/color_beige_dark"
            android:textColorHint="@color/color_beige_dark_30"
            app:layout_constraintEnd_toStartOf="@id/ivStepIcon"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvStepTitle" />

        <ImageButton
            android:id="@+id/ivStepIcon"
            style="@style/IconButtonStyle.Green"
            android:src="@drawable/ic_gallery"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>