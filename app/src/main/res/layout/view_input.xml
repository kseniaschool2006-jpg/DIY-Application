<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:layout_marginBottom="@dimen/space_medium">

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="@color/color_white"
        app:cardCornerRadius="@dimen/radius_standard"
        app:cardElevation="0dp"
        app:strokeWidth="1dp"
        app:strokeColor="@color/color_beige_dark"
        app:cardPreventCornerOverlap="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/space_medium"
            android:paddingBottom="@dimen/space_s"
            android:paddingEnd="@dimen/space_medium"
            android:paddingTop="@dimen/space_s">

            <TextView
                style="@style/TextAppearance.App.Subtext.Title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Название"
                android:textColor="@color/color_beige_dark" />

            <EditText
                android:id="@+id/etTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:background="@null"
                android:hint="Добавьте название материала"
                android:textAppearance="@style/TextAppearance.App.Body"
                android:textColor="@color/color_beige_dark"
                android:textColorHint="@color/color_beige_dark_30"
                android:inputType="text"
                android:maxLength="100" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_xs"
        android:paddingStart="@dimen/space_margin"
        android:paddingEnd="@dimen/space_margin">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:text="Максимум 100 символов"
            android:textAppearance="@style/TextAppearance.App.Subtext"
            android:textColor="@color/color_beige_dark_30" />

        <TextView
            android:id="@+id/tvTitleCounter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:text="0/100"
            android:textAppearance="@style/TextAppearance.App.Subtext"
            android:textColor="@color/color_beige_dark_30" />
    </RelativeLayout>
</LinearLayout>