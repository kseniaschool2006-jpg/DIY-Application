<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_white"
    tools:context=".ui.storage.MaterialSelectionFragment">

    <include
        layout="@layout/view_custom_toolbar"
        android:id="@+id/customToolbar"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerViewMaterials"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingHorizontal="@dimen/space_margin"
        android:paddingTop="@dimen/space_margin"
        android:paddingBottom="@dimen/space_s"
        app:layout_constraintBottom_toTopOf="@id/btnSelect"
        app:layout_constraintTop_toBottomOf="@id/customToolbar" />

    <Button
        android:id="@+id/btnSelect"
        style="@style/ButtonStyle.Primary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/space_margin"
        android:text="Выбрать"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>