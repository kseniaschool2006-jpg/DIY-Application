<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="@dimen/space_medium"
    android:paddingTop="@dimen/space_medium"
    android:paddingEnd="@dimen/space_medium">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <EditText
            android:id="@+id/et_search"
            style="@style/TextAppearance.App.Subtext"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/bg_search_bar"
            android:drawableEnd="@drawable/ic_camera_14"
            android:drawablePadding="@dimen/space_s"
            android:drawableTint="@color/color_beige_dark"
            android:hint="Поиск идей"
            android:imeOptions="actionSearch"
            android:importantForAutofill="no"
            android:inputType="text"
            android:maxLines="1"
            android:paddingStart="@dimen/space_medium"
            android:paddingTop="@dimen/space_s"
            android:paddingEnd="@dimen/space_medium"
            android:paddingBottom="@dimen/space_s"
            android:textColorHint="@color/color_beige_dark_30" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_cancel"
            style="@style/ButtonStyle.Primary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_s"
            android:text="Отмена" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_history"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/space_medium"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="100dp" />

</LinearLayout>